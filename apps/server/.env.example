DSH_SERVER_ACCOUNT=owner@example.com
DSH_SERVER_PASSWORD=replace-with-a-long-random-password
DSH_SERVER_HOST=127.0.0.1
DSH_SERVER_PORT=8080
# Must match the browser origin (scheme, hostname, port); use your HTTPS domain behind a proxy.
DSH_SERVER_PUBLIC_URL=http://localhost:8080
DSH_SERVER_DATA_FILE=./data/state.json

# Optional WebRTC ICE configuration. STUN is required for P2P across NAT;
# TURN is needed for symmetric NAT/CGNAT and mobile networks.
# Comma-separated URL lists. Prefer coturn use-auth-secret (short-lived credentials).
# DSH_SERVER_STUN_URLS=stun:stun.l.google.com:19302
# DSH_SERVER_TURN_URLS=turn:turn.example.com:3478?transport=udp
# DSH_SERVER_TURN_SECRET=replace-with-the-coturn-static-auth-secret
# DSH_SERVER_TURN_TTL=3600
# Static TURN credentials are also supported (less secure than a shared secret):
# DSH_SERVER_TURN_USERNAME=remote
# DSH_SERVER_TURN_PASSWORD=replace-with-a-long-random-password
